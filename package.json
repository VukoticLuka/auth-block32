{
  "name": "block32-jwt",
  "version": "1.0.1",
  "description": "A fully typed JWT authentication package for NestJS, inspired by @nestjs/jwt.",
  "author": "Luka Vukotic",
  "license": "MIT",
  "main": "./index.js",
  "files": [
    "dist/**/*",
    "README.md",
    "index.js",
    "index.d.ts",
    "LICENSE.md",
    "lefthook.yml",
    "tsconfig.build.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VukoticLuka/jwt-block32"
  },
  "bugs": {
    "url": "https://github.com/VukoticLuka/jwt-block32/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --check \"**/*.ts\"",
    "format:fix": "prettier --write -u \"**/*.ts\"",
    "lint": "eslint \"lib/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,lib,test}/**/*.ts\" --fix",
    "test": "jest --config=jest.config.json",
    "test:watch": "jest --config=jest.config.json --watch",
    "test:cov": "jest --config=jest.config.json --coverage",
    "local:link": "npm link",
    "prepublish": "npm run build",
    "publish": "npm publish --access public"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@arkweid/lefthook": "^0.7.7",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
